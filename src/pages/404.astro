---
import Layout from "../layouts/Layout.astro";

const title = "Page not found — Her AI Studio";
const description = "The page you're looking for doesn't exist or has been moved.";
---

<Layout {title} {description}>
  <main id="main-content" class="error-page">
    <h1>404</h1>
    <h2>Page not found</h2>
    <p>
      The page you're looking for doesn't exist or has been moved. Head back to the studio home.
    </p>
    <a href="/" class="error-cta">Back to Her AI Studio</a>
  </main>
</Layout>
