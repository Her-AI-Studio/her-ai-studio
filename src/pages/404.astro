---
import "../styles/workshop.css";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const title = "Page not found — Her AI Studio";
const description = "The page you're looking for doesn't exist or has been moved.";
---

<Layout {title} {description}>

  <Nav currentPath="/" />

  <main id="main-content" class="ws">
    <section class="ws-section not-found-section" aria-labelledby="not-found-heading">
      <div class="ws-shell">
        <p class="not-found-numeral" aria-hidden="true">404</p>
        <p class="ws-eyebrow">Off the map</p>
        <h1 id="not-found-heading" class="ws-h2">This page wandered off.</h1>
        <p class="ws-body ws-body--wide">
          The page you're looking for doesn't exist or has been moved. Let's get you back to the studio.
        </p>
        <div class="ws-primary-cta">
          <div class="join-popup">
            <a href="/" class="join-popup-btn">
              <span>Back to Her AI Studio</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer currentPath="/" />
  </main>

</Layout>

<style>
  .not-found-section {
    padding-top: 4rem;
    border-bottom: none;
  }

  .not-found-numeral {
    font-family: var(--ws-font-display);
    font-size: clamp(6rem, 20vw, 12rem);
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--ws-electric);
    margin: 0 0 1rem;
  }

  .not-found-section .ws-primary-cta {
    margin-top: 2rem;
  }
</style>
