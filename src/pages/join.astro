---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import RosieZara from "../assets/zara-rosie.png";

const title = "Join the Interest List — Her AI Studio";
const description = "Leave your email and be first to know when the first cohort opens: dates, details, and how to apply.";
---

<Layout {title} {description}>

  <Nav currentPath="/join" />

  <main id="main-content">
  <section id="join" class="studio-room room-cta" aria-labelledby="join-heading">
    <div class="room-inner">
      <div class="cta-layout">
        <div class="cta-copy">
          <p class="room-label cta-label" data-reveal>Interest list</p>
          <h2 class="cta-h2" id="join-heading" data-reveal data-delay="1">
            Talk to us!
          </h2>
          <p class="cta-sub" data-reveal data-delay="2">
            The first cohort is coming. Leave your email and we'll send you the date, the details, and how to apply. You'll be first to know.
          </p>
          <div data-reveal data-delay="3" class="cta-bullets">
            <p>Built at the grass roots</p>
            <p>Completely free to stay in the loop</p>
            <p>No experience needed</p>
          </div>
          <img
            class="cta-logo"
            src={RosieZara.src}
            width={RosieZara.width}
            height={RosieZara.height}
            alt="Her AI Studio"
            loading="lazy"
            decoding="async"
            data-reveal
            data-delay="4"
          />
        </div>

        <div class="google-form" data-reveal data-delay="2">
          <iframe
            src="https://docs.google.com/forms/d/e/1FAIpQLSd85ZFRjybbvWUcs2lV5106vJvtM-BLR6b9A6xZiRNw5C2Wyg/viewform?embedded=true"
            width="640"
            height="1297"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            title="Her AI Studio contact and interest form"
            loading="lazy"
          >Loading…</iframe>
        </div>
      </div>
    </div>
  </section>

  <Footer currentPath="/join" />
  </main>

</Layout>
