---
import Layout from "../layouts/Layout.astro";
import schematikLogo from "../assets/sponsors/schematik.png";

const title = "Sponsors — Her AI Studio";
const description = "Her AI Studio is made possible by sponsors who believe in equitable access to AI education for women and girls.";

const tiers = [
  {
    id: "founding",
    label: "Founding Partner",
    description: "Founding Partners make the entire program possible. Their investment funds cohorts, curriculum, and the infrastructure needed to reach students who would otherwise be left out.",
    perks: ["Named cohort sponsorship", "Logo on all program materials", "Founding Partner badge on site", "Direct impact reporting", "Featured in all press releases"],
    cta: "Become a Founding Partner",
    accent: "tier-founding",
    sponsors: [],
  },
  {
    id: "program",
    label: "Program Sponsor",
    description: "Program Sponsors fund specific tracks — a six-week cohort, a discover lab, or a showcase event. Your support is tied directly to a student outcome.",
    perks: ["Logo on program page", "Sponsor card in student workbooks", "Quarterly impact updates", "Social recognition"],
    cta: "Sponsor a Program",
    accent: "tier-program",
    sponsors: [],
  },
  {
    id: "hardware",
    label: "Hardware Sponsor",
    description: "Hardware is the biggest barrier for students in our program. Hardware Sponsors donate kits or funds to put real devices in students' hands.",
    perks: ["Logo in hardware kit inserts", "Recognition at showcase events", "Sponsor spotlight post", "Annual impact report"],
    cta: "Donate Hardware or Kits",
    accent: "tier-hardware",
    sponsors: [],
  },
  {
    id: "software",
    label: "Software Sponsor",
    description: "Software Sponsors provide tools, platforms, and subscriptions that power what students build. From AI APIs to design tools, these contributions make the curriculum possible.",
    perks: ["Logo on curriculum pages", "Tool spotlight in student onboarding", "Recognition on website", "Social media mention"],
    cta: "Donate Software Access",
    accent: "tier-software",
    sponsors: [
      {
        name: "Schematik",
        description: "Schematik is an AI-powered IDE built to make hardware prototyping accessible to everyone. Whether you're wiring up an Arduino, programming an ESP32, or building your first Pico project, Schematik's AI assistant guides you from idea to working circuit — no deep electronics expertise required. It's exactly the kind of tool that puts hardware creation in reach of students who have never held a soldering iron.",
        url: "https://schematik.io",
        logo: schematikLogo,
      },
    ],
  },
  {
    id: "community",
    label: "Community Supporter",
    description: "Community Supporters contribute in-kind services, expertise, or smaller funding that adds up. Every contribution counts toward a student's journey.",
    perks: ["Name listed on website", "Thank-you in newsletter", "Social recognition"],
    cta: "Become a Supporter",
    accent: "tier-community",
    sponsors: [],
  },
];
---

<Layout {title} {description}>

  <nav id="studio-nav" class="studio-nav" aria-label="Main navigation">
    <a href="/" class="nav-logo">Her AI Studio</a>
    <ul id="nav-primary" class="nav-links">
      <li><a href="/#why">Why</a></li>
      <li><a href="/#discover">Discover</a></li>
      <li><a href="/#program">Program</a></li>
      <li><a href="/team">Team</a></li>
      <li><a href="/sponsors" aria-current="page">Sponsors</a></li>
      <li><a href="/prospectus.pdf" target="_blank" rel="noopener">Prospectus</a></li>
    </ul>
    <div class="nav-trailing">
      <a href="/#join" class="nav-apply">Get updates</a>
      <button
        type="button"
        id="nav-menu-btn"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-primary"
      >
        <span class="nav-toggle-bars" aria-hidden="true"></span>
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </nav>

  <div id="nav-backdrop" class="nav-backdrop" hidden aria-hidden="true"></div>

  <main id="main-content">

    <section class="sponsors-hero">
      <div class="team-inner">
        <p class="room-label">Make it possible</p>
        <h1 class="team-h1">Sponsors power<br>the next generation.</h1>
        <p class="team-lead">
          Her AI Studio is free for every student. That means we depend entirely on sponsors who share our belief that girls and women deserve equal access to AI education. Every dollar goes directly to students.
        </p>
        <a href="/prospectus.pdf" target="_blank" rel="noopener" class="sponsors-hero-cta">
          Download the sponsorship prospectus
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 3v7M5 7l3 3 3-3M3 13h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>

    <section class="sponsors-tiers-section" aria-labelledby="tiers-heading">
      <div class="team-inner">
        <h2 id="tiers-heading" class="sr-only">Sponsorship tiers</h2>

        {tiers.map((tier) => (
          <article class={`sponsors-tier ${tier.accent}`} aria-labelledby={`tier-${tier.id}`}>
            <div class="sponsors-tier__header">
              <span class="sponsors-tier__label">{tier.label}</span>
              <h3 id={`tier-${tier.id}`} class="sr-only">{tier.label}</h3>
            </div>
            <div class="sponsors-tier__body">
              <p class="sponsors-tier__desc">{tier.description}</p>
              <ul class="sponsors-tier__perks" aria-label="Sponsor benefits">
                {tier.perks.map((perk) => (
                  <li>
                    <span class="sponsors-tier__check" aria-hidden="true">✦</span>
                    {perk}
                  </li>
                ))}
              </ul>
              {tier.sponsors.length > 0 && (
                <div class="sponsors-tier__current">
                  <p class="sponsors-tier__current-label">Current sponsors</p>
                  <ul class="sponsors-tier__sponsor-list" role="list">
                    {tier.sponsors.map((s) => (
                      <li class="sponsors-tier__sponsor-card">
                        <div class="sponsors-tier__sponsor-top">
                          {s.logo && (
                            <img
                              src={s.logo.src}
                              width={s.logo.width}
                              height={s.logo.height}
                              alt={s.name}
                              loading="lazy"
                              decoding="async"
                              class="sponsors-tier__sponsor-logo"
                            />
                          )}
                          {s.url && (
                            <a href={s.url} target="_blank" rel="noopener" class="sponsors-tier__sponsor-visit">
                              Visit {s.name}
                              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                <path d="M2 10L10 2M10 2H5M10 2v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </a>
                          )}
                        </div>
                        {s.description && (
                          <p class="sponsors-tier__sponsor-blurb">{s.description}</p>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <a href="/#join" class="sponsors-tier__cta">{tier.cta} →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="team-join-section">
      <div class="team-inner team-join-inner">
        <div>
          <h2 class="team-join-h2">Ready to sponsor?</h2>
          <p class="team-join-body">
            Download the full prospectus or join the interest list and we'll be in touch with details on how your sponsorship directly funds student outcomes.
          </p>
        </div>
        <div class="sponsors-cta-group">
          <a href="/prospectus.pdf" target="_blank" rel="noopener" class="team-join-cta">
            View prospectus
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="/#join" class="sponsors-cta-secondary">Join interest list</a>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <div class="studio-footer">
        <div class="footer-brand">
          <p>© 2026 Her AI Studio</p>
          <p>A 501(c)(3) nonprofit registered in Massachusetts, USA. EIN 42-3042277</p>
          <p>A community program for the next generation of women in AI.</p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/#why">Why</a>
          <a href="/#discover">Discover</a>
          <a href="/#program">Program</a>
          <a href="/team">Team</a>
          <a href="/sponsors">Sponsors</a>
          <a href="/#join">Interest list</a>
          <a href="https://discord.gg/aBvM6CsWYG" target="_blank" rel="noopener" class="footer-discord">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.032.054a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            Join our Discord
          </a>
        </nav>
      </div>
    </footer>
  </main>

  <script is:inline>
    const nav = document.getElementById("studio-nav");
    if (nav) {
      window.addEventListener("scroll", () =>
        nav.classList.toggle("nav-scrolled", window.scrollY > 60), { passive: true }
      );
    }
    const menuBtn = document.getElementById("nav-menu-btn");
    const backdrop = document.getElementById("nav-backdrop");
    const navPrimary = document.getElementById("nav-primary");
    function closeMenu() {
      if (!nav || !menuBtn) return;
      nav.classList.remove("nav-menu-open");
      menuBtn.setAttribute("aria-expanded", "false");
      const sr = menuBtn.querySelector(".sr-only");
      if (sr) sr.textContent = "Open menu";
      if (backdrop) { backdrop.hidden = true; backdrop.setAttribute("aria-hidden", "true"); }
      document.body.classList.remove("nav-menu-open");
    }
    function openMenu() {
      if (!nav || !menuBtn) return;
      nav.classList.add("nav-menu-open");
      menuBtn.setAttribute("aria-expanded", "true");
      const sr = menuBtn.querySelector(".sr-only");
      if (sr) sr.textContent = "Close menu";
      if (backdrop) { backdrop.hidden = false; backdrop.setAttribute("aria-hidden", "false"); }
      document.body.classList.add("nav-menu-open");
    }
    if (menuBtn && nav && backdrop && navPrimary) {
      menuBtn.addEventListener("click", () => {
        if (nav.classList.contains("nav-menu-open")) closeMenu(); else openMenu();
      });
      backdrop.addEventListener("click", closeMenu);
      navPrimary.querySelectorAll("a").forEach(a => a.addEventListener("click", closeMenu));
      window.addEventListener("keydown", e => { if (e.key === "Escape") closeMenu(); });
      window.addEventListener("resize", () => { if (window.matchMedia("(min-width: 641px)").matches) closeMenu(); });
    }
  </script>
</Layout>
