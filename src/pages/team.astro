---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import jen from "../assets/jen.webp";
import laylah from "../assets/laylah.jpg"
import jess from "../assets/jess.jpg"
import ifeoma from "../assets/ifeoma.jpg"


const title = "Our Team — Her AI Studio";
const description = "Meet the people building Her AI Studio, a free creative AI program for girls and people who identify as women.";

const team = [
  {
    name: "Jen Looper",
    role: "Founder & Director",
    bio: "Developer advocate, educator, and community builder passionate about closing the gender gap in AI and tech, Jen is the Director of Developer Relations at Cloudinary, and previously led educational and student programs at Microsoft and AWS. She also founded Vue Vixens, later branded as Front-End Foxes, educating thousands of women from 2018-2023. An educator technologist, Jen is passionate about building communities that are equitable, educational, and fun!",
    image: jen,
    imageAlt: "Jen Looper",
    web: "https://jenlooper.com"
  },
  {
    name: "Laylah Bulman",
    role: "Partnerships & Sponsorships Lead",
    bio: "Laylah Bulman leads partnerships and sponsorships for Her AI Studio. She started in the classroom and has spent her career building learning products for young people, at LEGO Education, at NASEF, where she helped scale scholastic esports globally, and now in leading learning content at Minecraft. At Minecraft Education, she built partnerships with TeachAI, 4-H, and NASA, including the Artemis Missions worlds and an AI literacy program that reached 1.4 million learners. She loves to dream and invent and is a creator at heart.",
    image: laylah,
    imageAlt: "Laylah Bulman",
  },
  {
    name: "Ifeoma Nwosu",
    role: "Community & Mentorship Lead",
    bio: "Ifeoma is a software engineer passionate about seeing women and girls well represented in technology. That passion stems from challenges she faced early in her own career. She has spoken at technical conferences and has volunteered and mentored through organisations dedicated to advancing women in tech, including Code First Girls, She Code Africa, and Front-End Foxes, where she served as Community Lead for the Nigerian branch and bootcamp instructor during COVID for EMEA learners online. Her love of teaching also led her to become a LinkedIn Learning author. When she's not writing code, you'll find her behind a camera, hiking, or playing tennis.",
    image: ifeoma, 
    imageAlt: "Ifeoma Nwosu",
  },
  {
    name: "Jess Lee",
    role: "Operations Lead",
    bio: "Jess Lee is an entrepreneur and community builder serving as Founder-in-Residence at Major League Hacking (MLH), which she joined following its acquisition of DEV – the global developer community she co-founded and scaled into one of the largest, most inclusive spaces for software developers. Having also served as DEV’s COO, and earlier as a nonprofit product manager and marketer, Jess brings a rare combination of operational, technical, and mission-driven experience to her work. As a coding bootcamp graduate herself, she is deeply committed to building accessible, supportive spaces where aspiring builders, especially those from underrepresented backgrounds, can learn, connect, and thrive. Based in Rochester, NY, Jess is excited to bring that same energy to helping girls find their footing in AI.",
    image: jess,
    imageAlt: "Jess Lee",
  },
];
---

<Layout {title} {description}>

  <Nav currentPath="/team" />

  <main id="main-content">
    <section class="team-hero">
      <div class="team-inner">
        <p class="room-label">The people behind it</p>
        <h1 class="team-h1">Built by women at the grass roots<br>for the next generation.</h1>
        <p class="team-lead">
          Her AI Studio is led by a small, mission-driven team of educators, engineers, and community builders who believe every woman deserves a seat at the AI table.
        </p>
      </div>
    </section>

    <section class="team-grid-section" aria-labelledby="team-members-heading">
      <div class="team-inner">
        <h2 id="team-members-heading" class="sr-only">Team members</h2>
        <ul class="team-grid" role="list">
          {team.map((member) => (
            <li class="team-card">
              <div class="team-card__portrait">
                {member.image ? (
                  <img
                    src={member.image.src}
                    width={member.image.width}
                    height={member.image.height}
                    alt={member.imageAlt}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="team-card__placeholder" aria-hidden="true">
                    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                      <circle cx="20" cy="16" r="7" stroke="currentColor" stroke-width="2"/>
                      <path d="M6 36c0-7.732 6.268-14 14-14s14 6.268 14 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </div>
                )}
              </div>
              <div class="team-card__body">
                <h3 class="team-card__name">{member.name}</h3>
                <p class="team-card__role">{member.role}</p>
                <p class="team-card__bio">{member.bio}</p>
                {member.web && <p class="team-card__bio"><a class="underline" href={member.web}>{member.web}</a></p>}

              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="team-board-section" aria-labelledby="board-heading">
      <div class="team-inner">
        <p class="room-label">Governance</p>
        <h2 id="board-heading" class="team-board-h2">Board of Directors</h2>
        <p class="team-board-lead">
          Her AI Studio is governed by an independent board committed to our mission of equity, access, and excellence in AI education.
        </p>
        <ul class="team-board-list" role="list">
          {[1, 2, 3].map(() => (
            <li class="team-board-card">
              <div class="team-board-card__avatar" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
                  <circle cx="20" cy="16" r="7" stroke="currentColor" stroke-width="2"/>
                  <path d="M6 36c0-7.732 6.268-14 14-14s14 6.268 14 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <p class="team-board-card__name">Coming soon</p>
                <p class="team-board-card__title">Board Member</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="team-board-note">
          We are actively recruiting founding board members with expertise in education, AI, nonprofit management, and fundraising. <a href="/join">Reach out if you're interested.</a>
        </p>
      </div>
    </section>

    <section class="team-board-section" aria-labelledby="curriculum-heading">
      <div class="team-inner">
        <p class="room-label">Curriculum</p>
        <h2 id="curriculum-heading" class="team-board-h2">Curriculum Committee</h2>
        <p class="team-board-lead">
          A group of educators, engineers, and AI practitioners who shape what gets taught and how. We're assembling this committee now.
        </p>
        <ul class="team-board-list" role="list">
          {[1, 2, 3, 4].map(() => (
            <li class="team-board-card">
              <div class="team-board-card__avatar" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
                  <circle cx="20" cy="16" r="7" stroke="currentColor" stroke-width="2"/>
                  <path d="M6 36c0-7.732 6.268-14 14-14s14 6.268 14 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <p class="team-board-card__name">Coming soon</p>
                <p class="team-board-card__title">Curriculum Committee Member</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="team-board-note">
          We're looking for educators and practitioners with expertise in AI, computer science, and project-based learning. <a href="/join">Get in touch.</a>
        </p>
      </div>
    </section>

    <section class="team-join-section">
      <div class="team-inner team-join-inner">
        <div>
          <h2 class="team-join-h2">Want to be part of this?</h2>
          <p class="team-join-body">
            We're looking for mentors, advisors, curriculum contributors, and community partners. Hardware is expensive! We need sponsors! If you're passionate about women in AI, let's talk.
          </p>
        </div>
        <a href="/join" class="team-join-cta">
          Get in touch
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>

    <Footer currentPath="/team" />
  </main>
</Layout>
