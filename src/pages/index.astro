---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Join from "../components/Join.astro";
import { Image, getImage } from "astro:assets";
import logoImage from "../assets/logo.png";
import cyberdeckImage from "../assets/cyberdeck.png";
import discoverLab from "../assets/discover-lab.png";
import whyBuild from "../assets/why/build.png";
import whySisterhood from "../assets/why/sisterhood.png";
import whySkills from "../assets/why/skills.png";

const title = "Her AI Studio, a creative AI space for the next generation of women";
const description =
  "Her AI Studio is a free studio program for girls and people who identify as women building with AI. Join the interest list for the first cohort.";
const ogTitle = "Her AI Studio";
const ogDescription = "Get updates on a free creative AI studio for women in grades 9–12.";

// Responsive config for the LCP (hero) image. Kept in one place so the
// preload in <head> always matches the <Image> srcset/sizes.
const heroImageWidths = [480, 640, 875];
const heroImageSizes = "(max-width: 769px) min(560px, 94vw), 40vw";
const heroImage = await getImage({
  src: logoImage,
  widths: heroImageWidths,
  sizes: heroImageSizes,
});
---

<Layout {title} {description} {ogTitle} {ogDescription}>

  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroImage.src}
    imagesrcset={heroImage.srcSet.attribute}
    imagesizes={heroImageSizes}
    fetchpriority="high"
  />

  <Nav currentPath="/" />

  <main id="main-content">
  <section id="door" class="studio-room room-door" aria-labelledby="door-heading">
    <div class="room-inner" style="padding-top:0;padding-bottom:0;">
      <div class="door-grid">

        <div>
          <h1 id="door-heading" class="door-lead-h1" data-reveal>
            A Creative AI Studio
          </h1>
          <p class="door-tagline" data-reveal data-delay="1">
            Build AI Better. Build Better AI.
          </p>
          <p class="door-meta" data-reveal data-delay="2">
            For grades 9-12 <span aria-hidden="true">·</span>Always free <span aria-hidden="true">·</span> Beginner-friendly <span aria-hidden="true">·</span> Build your cyberdeck!
          </p>
          
          <a href="/join" class="door-cta" data-reveal data-delay="4">
            Join the list
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div class="door-hero-col" data-reveal data-delay="1">
          <Image
            src={logoImage}
            alt="Illustration of a girl in a hanging bubble chair with a laptop, orbited by a ring of purple stars on a dark background."
            widths={heroImageWidths}
            sizes={heroImageSizes}
            priority
          />
        </div>

      </div>
    </div>
  </section>

  <section id="cyberdeck" class="studio-room room-cyberdeck" aria-labelledby="cyberdeck-heading">
    <div class="room-inner">
      <div class="cyberdeck-grid">

        <div class="cyberdeck-copy">
          <p class="room-label" data-reveal>What you'll build</p>
          <h2 id="cyberdeck-heading" class="cyberdeck-h2" data-reveal data-delay="1">
            Your<br>cyberdeck
          </h2>
          <p class="cyberdeck-body" data-reveal data-delay="2">
            Apply to join one of our in-person cohorts. By the end of six weeks, you'll earn your builder kit to build your custom cyberdeck: a pocket-sized AI computer built inside a case. You'll wire it up, program it, and take it home at the end of the program. Run it offline, with local models, using data you control and manage.
          </p>
          <ul class="cyberdeck-specs" aria-label="What's inside" data-reveal data-delay="3">
            <li>Arduino-powered brain</li>
            <li>Mini bluetooth keyboard</li>
            <li>Local AI Models</li>
            <li>Yours to keep</li>
          </ul>
          <a href="/program" class="cyberdeck-cta" data-reveal data-delay="4">
            See the curriculum
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <figure class="cyberdeck-figure" data-reveal data-delay="1">
          <Image
            src={cyberdeckImage}
            alt="Your own cyberdeck"
            widths={[480, 720, 960, 1402]}
            sizes="(max-width: 769px) 94vw, 52vw"
            loading="lazy"
            decoding="async"
          />
        </figure>

      </div>
    </div>
  </section>

  <section id="discover" class="studio-room room-discover" aria-labelledby="discover-heading">
    <div class="room-inner">
      <p class="room-label" data-reveal>Discover</p>
      <div class="discover-grid">
        <div class="discover-copy">
          <h2 id="discover-heading" class="discover-h2" data-reveal data-delay="1">
            Learn deeply.<br /><span class="discover-h2__sub">Then teach someone else.</span>
          </h2>
          <p class="discover-lead" data-reveal data-delay="2">
            In this program, you'll walk a path the women who built this field have already walked: go from figuring things out to explaining them, from trying prompts to guiding someone through theirs, from "I get it" to "let me show you." Leadership here isn't a title you wait for. It's a muscle you grow by helping the room rise with you.
          </p>
          <p class="discover-kicker" data-reveal data-delay="2">
            <strong>Women who opened the door.</strong> Joy Buolamwini was a grad student when she proved facial recognition software was biased against darker skin; her research changed how companies worldwide build AI. Fei-Fei Li spent years building a massive dataset so computers could learn to see the world. Timnit Gebru co-authored research that made powerful AI labs deeply uncomfortable. You'll study what they built and why it mattered, not to follow one career path, but because the next generation of leaders in this field is you.
          </p>
        </div>
        <figure class="discover-figure" data-reveal data-delay="2">
          <Image
            src={discoverLab}
            alt="A mentor presents to a group of students in a neon-lit classroom, with screens about what AI is and portraits of women leaders in the field."
            widths={[400, 560, 751]}
            sizes="(max-width: 900px) min(520px, 92vw), 46vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="why" class="studio-room room-floor" aria-labelledby="why-heading">
    <div class="room-inner">
      <p class="room-label" data-reveal>Why we built this</p>
      <h2 id="why-heading" style="font-size:clamp(2.5rem,5.5vw,4rem);margin-bottom:2.5rem;max-width:100%;" data-reveal data-delay="1">
        Where girls and women become<br>confident AI creators, builders, and engineers.
      </h2>

      <div class="why-zigzag">
        <article class="why-row why-row--media-end" data-reveal data-delay="2">
          <div class="why-row__text">
            <h3 class="why-row__title">
              <span class="why-row__glyph" aria-hidden="true">✦</span>
              Build real things
            </h3>
            <p class="why-row__body">
              Work with real hardware to build your own cyberdeck: a pocket-sized AI device you design and program yourself.
            </p>
          </div>
          <figure class="why-row__figure">
            <Image
              src={whyBuild}
              width={526}
              height={324}
              alt="Three students collaborating at a table with laptops, a tablet, and floating previews of apps and creative tools."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>

        <article class="why-row why-row--media-start" data-reveal data-delay="3">
          <figure class="why-row__figure">
            <Image
              src={whySisterhood}
              width={650}
              height={306}
              alt="Five students gathered around a laptop, learning together in a warm, welcoming space."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="why-row__text">
            <h3 class="why-row__title">
              <span class="why-row__glyph why-row__glyph--heart" aria-hidden="true">♡</span>
              A sisterhood
            </h3>
            <p class="why-row__body">
              Learn alongside the people who get it. Mentors, peers, and role models who look like you.
            </p>
          </div>
        </article>

        <article class="why-row why-row--media-end" data-reveal data-delay="4">
          <div class="why-row__text">
            <h3 class="why-row__title">
              <span class="why-row__glyph why-row__glyph--future" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 18c4.5-1 8-4 11.5-8.5S19.5 5.5 21 4" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 20.5h18" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/>
                  <circle cx="21" cy="4" r="2.35" fill="currentColor"/>
                  <path d="M17.5 3.5 21 4l-1.2 3.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              Future-ready skills
            </h3>
            <p class="why-row__body">
              Local AI, prompt engineering, machine learning intuition, and ethical AI thinking that schools don't teach yet.
            </p>
          </div>
          <figure class="why-row__figure">
            <Image
              src={whySkills}
              width={515}
              height={342}
              alt="A student at her desk at night with floating panels about prompts, machine learning, and ethical AI."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>
      </div>
    </div>
  </section>

  <section id="interest" class="studio-room room-cta" aria-labelledby="interest-heading">
    <div class="room-inner">
      <div class="cta-layout">
        <div class="cta-copy">
          <p class="room-label cta-label" data-reveal>Interest list</p>
          <h2 class="cta-h2" id="interest-heading" data-reveal data-delay="1">
            Join the interest list
          </h2>
          <p class="cta-sub" data-reveal data-delay="2">
            The first cohort is coming. Leave your email and we'll send you the date, the details, and how to apply. You'll be first to know.
          </p>
          <div class="cta-bullets" data-reveal data-delay="3">
            <p>Built at the grass roots</p>
            <p>Completely free to stay in the loop</p>
            <p>No experience needed</p>
          </div>
        </div>

        <article class="cta-form-col" data-reveal data-delay="2">
          <Join />
        </article>
      </div>
    </div>
  </section>

  <Footer currentPath="/" />
  </main>

</Layout>
