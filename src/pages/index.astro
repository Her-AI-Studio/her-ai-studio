---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import logoImage from "../assets/logo.png";
import bubbleZara from "../assets/hero-bubble.png";
import whyBuild from "../assets/why/build.png";
import whySisterhood from "../assets/why/sisterhood.png";
import whySkills from "../assets/why/skills.png";
import stationDiscover from "../assets/stations/discover.png";
import stationCreate from "../assets/stations/create.png";
import stationEngineer from "../assets/stations/engineer.png";
import stationShowcase from "../assets/stations/showcase.png";
import discoverLab from "../assets/discover-lab.png";

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_FORM_ID ?? "";
const formspreeUrl = formspreeId ? `https://formspree.io/f/${formspreeId}` : "";

const title = "Her AI Studio, a creative AI space for the next generation of women";
const description =
  "Her AI Studio is a free studio program for girls and people who identify as women building with AI. Join the interest list for the first cohort.";
const ogTitle = "Her AI Studio";
const ogDescription = "Get updates on a free creative AI studio for women in grades 9–12.";
---

<Layout {title} {description} {ogTitle} {ogDescription}>

  <Nav currentPath="/" />

  <nav class="room-progress" aria-hidden="true">
    <div class="room-dot active" data-room="door"></div>
    <div class="room-dot" data-room="why"></div>
    <div class="room-dot" data-room="discover"></div>
    <div class="room-dot" data-room="program"></div>
    <div class="room-dot" data-room="join"></div>
  </nav>

  <div id="sr-section" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

  <main id="main-content">
  <!-- ROOM 1 -->
  <section id="door" class="studio-room room-door" aria-labelledby="door-heading">
    <div class="room-inner" style="padding-top:0;padding-bottom:0;">
      <div class="door-grid">

        <div>
          <h1 id="door-heading" class="door-lead-h1" data-reveal>
            A Creative AI Studio
          </h1>
          <p class="door-tagline" data-reveal data-delay="1">
            Show up curious.<br>Imagine it. Build it!
          </p>
          <p class="door-meta" data-reveal data-delay="2">
            For grades 9-12 <span aria-hidden="true">·</span>Always free <span aria-hidden="true">·</span> Beginner-friendly 
          </p>
          <a href="#join" class="door-cta" data-reveal data-delay="3">
            Join the list
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <div class="scroll-cue" data-reveal data-delay="4" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Scroll</span>
          </div>
        </div>

        <div class="door-hero-col" data-reveal data-delay="1">
          <img
            src={logoImage.src}
            width={logoImage.width}
            height={logoImage.height}
            alt="Illustration of a girl in a hanging bubble chair with a laptop, orbited by a ring of purple stars on a dark background."
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ROOM 2 -->
  <section id="why" class="studio-room room-floor" aria-labelledby="why-heading">
    <div class="room-inner">
      <p class="room-label" data-reveal>Why we built this</p>
      <h2 id="why-heading" style="font-size:clamp(2.5rem,5.5vw,4rem);margin-bottom:2.5rem;max-width:100%;" data-reveal data-delay="1">
        Where girls and women become<br>confident AI creators, builders, and engineers.
      </h2>

      <div class="why-zigzag">
        <article class="why-row why-row--media-end" data-reveal data-delay="2">
          <div class="why-row__text">
            <h3 class="why-row__title">
              <span class="why-row__glyph" aria-hidden="true">✦</span>
              Build real things
            </h3>
            <p class="why-row__body">
              Work with real hardware to build your own cyberdeck: a pocket-sized AI device you design and program yourself.
            </p>
            
          </div>
          <figure class="why-row__figure">
            <img
              src={whyBuild.src}
              width={whyBuild.width}
              height={whyBuild.height}
              alt="Three students collaborating at a table with laptops, a tablet, and floating previews of apps and creative tools."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>

        <article class="why-row why-row--media-start" data-reveal data-delay="3">
          <figure class="why-row__figure">
            <img
              src={whySisterhood.src}
              width={whySisterhood.width}
              height={whySisterhood.height}
              alt="Five students gathered around a laptop, learning together in a warm, welcoming space."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="why-row__text">
            <h3 class="why-row__title">
              <span class="why-row__glyph why-row__glyph--heart" aria-hidden="true">♡</span>
              A sisterhood
            </h3>
            <p class="why-row__body">
              Learn alongside the people who get it. Mentors, peers, and role models who look like you.
            </p>
          </div>
        </article>

        <article class="why-row why-row--media-end" data-reveal data-delay="4">
          <div class="why-row__text">
            <h3 class="why-row__title">
              <span class="why-row__glyph why-row__glyph--future" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M3 18c4.5-1 8-4 11.5-8.5S19.5 5.5 21 4"
                    stroke="currentColor"
                    stroke-width="1.85"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path d="M3 20.5h18" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" />
                  <circle cx="21" cy="4" r="2.35" fill="currentColor" />
                  <path
                    d="M17.5 3.5 21 4l-1.2 3.2"
                    stroke="currentColor"
                    stroke-width="1.35"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              Future-ready skills
            </h3>
            <p class="why-row__body">
              Local AI, prompt engineering, machine learning intuition, and ethical AI thinking that schools don't teach yet.
            </p>
          </div>
          <figure class="why-row__figure">
            <img
              src={whySkills.src}
              width={whySkills.width}
              height={whySkills.height}
              alt="A student at her desk at night with floating panels about prompts, machine learning, and ethical AI."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>
      </div>
    </div>
  </section>

  <!-- ROOM 3: Discover -->
  <section id="discover" class="studio-room room-discover" aria-labelledby="discover-heading">
    <div class="room-inner">
      <p class="room-label" data-reveal>Discover</p>
      <div class="discover-grid">
        <div class="discover-copy">
          <h2 id="discover-heading" class="discover-h2" data-reveal data-delay="1">
            Learn deeply.<br /><span class="discover-h2__sub">Then teach someone else.</span>
          </h2>
          <p class=”discover-lead” data-reveal data-delay=”2”>
            In this program, you’ll walk a path the women who built this field have already walked: go from figuring things out to explaining them, from trying prompts to guiding someone through theirs, from “I get it” to “let me show you.” Leadership here isn’t a title you wait for. It’s a muscle you grow by helping the room rise with you.
          </p>
          <p class=”discover-kicker” data-reveal data-delay=”2”>
            <strong>Women who opened the door.</strong> Joy Buolamwini was a grad student when she proved facial recognition software was biased against darker skin; her research changed how companies worldwide build AI. Fei-Fei Li spent years building a massive dataset so computers could learn to see the world. Timnit Gebru co-authored research that made powerful AI labs deeply uncomfortable. You’ll study what they built and why it mattered, not to follow one career path, but because the next generation of leaders in this field is you.
          </p>
         
        </div>
        <figure class="discover-figure" data-reveal data-delay="2">
          <img
            src={discoverLab.src}
            width={discoverLab.width}
            height={discoverLab.height}
            alt="A mentor presents to a group of students in a neon-lit classroom, with screens about what AI is and portraits of women leaders in the field."
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ROOM 4 -->
  <section id="program" class="studio-room room-benches" aria-labelledby="program-heading">
    <div class="room-inner">
      <p class="room-label" data-reveal>What we're shaping</p>
      <h2 id="program-heading" style="font-size:clamp(2.5rem,5.5vw,4rem);margin-bottom:0.75rem;max-width:100%;" data-reveal data-delay="1">
        Three stations.<br>Six weeks.
      </h2>
      <p style="color:var(--muted-foreground);font-size:1.1rem;margin-bottom:2.25rem;max-width:52ch;" data-reveal data-delay="2">
        We're designing the studio around these beats. Details may evolve as we build the cohort, and we'll share milestones when you join the list.
      </p>

      <ol class="workbench-stations">
        <li class="station" data-reveal data-delay="1">
          <div class="station-text">
            <span class="sr-only">Station 1</span>
            <h3 class="station-title">Beginners: Discover</h3>
            <p class="station-body">What is AI really? Demystify the tech and meet women already shaping the field. Build your first locally-powered AI app.</p>
          </div>
          <figure class="station-sticker">
            <img
              src={stationDiscover.src}
              width={stationDiscover.width}
              height={stationDiscover.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </figure>
        </li>
        <li class="station" data-reveal data-delay="2">
          <div class="station-text">
            <span class="sr-only">Station 2</span>
            <h3 class="station-title">Intermediate: Create</h3>
            <p class="station-body">Build your first AI-powered project bridging hardware and software in image, text, or voice.</p>
          </div>
          <figure class="station-sticker">
            <img
              src={stationCreate.src}
              width={stationCreate.width}
              height={stationCreate.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </figure>
        </li>
        <li class="station" data-reveal data-delay="3">
          <div class="station-text">
            <span class="sr-only">Station 3</span>
            <h3 class="station-title">Advanced: Engineer</h3>
            <p class="station-body">Build your cyberdeck: your own AI-powered device. No programming experience needed.</p>
          </div>
          <figure class="station-sticker">
            <img
              src={stationEngineer.src}
              width={stationEngineer.width}
              height={stationEngineer.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </figure>
        </li>
        <li class="station" data-reveal data-delay="4">
          <div class="station-text">
            <span class="sr-only">Bonus: Showcase</span>
            <h3 class="station-title">Capstone</h3>
            <p class="station-body">Present your work at a studio showcase to friends, family, and industry guests.</p>
          </div>
          <figure class="station-sticker">
            <img
              src={stationShowcase.src}
              width={stationShowcase.width}
              height={stationShowcase.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </figure>
        </li>
      </ol>
    </div>
  </section>

  <!-- ROOM 5 -->
  <section id="join" class="studio-room room-cta" aria-labelledby="join-heading">
    <div class="room-inner">
      <div class="cta-layout">
        <div class="cta-copy">
          <p class="room-label cta-label" data-reveal>Interest list</p>
          <h2 class="cta-h2" id="join-heading" data-reveal data-delay="1">
            Talk to us!
          </h2>
          <p class="cta-sub" data-reveal data-delay="2">
            The first cohort is coming. Leave your email and we'll send you the date, the details, and how to apply. You'll be first to know.
          </p>
          <div data-reveal data-delay="3" class="cta-bullets">
            <p>Built at the grass roots</p>
            <p>Completely free to stay in the loop</p>
            <p>No experience needed</p>
          </div>
          <img
            class="cta-logo"
            src={bubbleZara.src}
            width={bubbleZara.width}
            height={bubbleZara.height}
            alt="Her AI Studio"
            loading="lazy"
            decoding="async"
            data-reveal
            data-delay="4"
          />
        </div>

        <div data-reveal data-delay="2">
          <p id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
          <form
            id="interest-form"
            class="apply-form"
            method="post"
            data-formspree-url={formspreeUrl}
          >
            <input type="hidden" name="_subject" value="Her AI Studio interest list" />
            <div class="form-field">
              <label for="apply-name">Your name</label>
              <input type="text" id="apply-name" name="name" placeholder="Full name" autocomplete="name" required maxlength="120" />
            </div>
            <div class="form-field">
              <label for="apply-email">Email address</label>
              <input type="email" id="apply-email" name="email" placeholder="you@email.com" autocomplete="email" required maxlength="254" />
            </div>
            <div class="form-field">
              <label for="apply-role">I'm a(n):</label>
              <select id="apply-role" name="role" required>
                <option value="">Choose one</option>
                <option value="under">Student (under 9th grade)</option>
                <option value="student">Student (grades 9–12 or College)</option>
                <option value="parent">Parent or guardian</option>
                <option value="educator">Educator</option>
                <option value="sponsor">Potential Sponsor</option>
              </select>
            </div>
            <div class="form-field">
              <label for="apply-create">What do you want to tell us? <span class="label-optional">(optional)</span></label>
              <textarea id="apply-create" name="message" placeholder="Reach out! We're eager to hear your thoughts." rows="4" maxlength="2000"></textarea>
            </div>
            <input
              type="text"
              name="_gotcha"
              class="form-honeypot"
              tabindex="-1"
              autocomplete="off"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              data-lpignore="true"
              data-1p-ignore
              data-bwignore
              aria-hidden="true"
            />
            <button type="submit" class="submit-btn" id="interest-submit">
              {formspreeUrl ? "Join the interest list" : "Configure Formspree to enable"}
            </button>
            <p class="form-fine-print">
              We respect your inbox. Unsubscribe anytime. If you're under 13, a parent should submit for you.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer currentPath="/" />
  </main>

  <script is:inline define:vars={{ formspreeUrl }}>
  const revealObserver = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      }),
    { threshold: 0.12, rootMargin: "0px 0px -32px 0px" },
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => revealObserver.observe(el));

  const rooms = document.querySelectorAll(".studio-room");
  const dots = document.querySelectorAll(".room-dot");
  const srSection = document.getElementById("sr-section");
  const sectionTitles = {
    door: "Intro",
    why: "Why we built this",
    discover: "Discover: learn, then teach",
    program: "What we're shaping",
    join: "Interest list",
  };

  const navLinks = document.querySelectorAll(".nav-links a[href^='#']");

  const roomObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const id = e.target.id;
          dots.forEach((d) => d.classList.remove("active"));
          const match = document.querySelector('.room-dot[data-room="' + id + '"]');
          if (match) match.classList.add("active");
          if (srSection && sectionTitles[id]) {
            srSection.textContent = "Section: " + sectionTitles[id];
          }
          navLinks.forEach((a) => {
            const active = a.getAttribute("href") === "#" + id;
            a.toggleAttribute("aria-current", active);
            if (active) a.setAttribute("aria-current", "page");
          });
        }
      });
    },
    { threshold: 0.45 },
  );
  rooms.forEach((r) => roomObserver.observe(r));

  const form = document.getElementById("interest-form");
  const submitBtn = document.getElementById("interest-submit");
  const formStatus = document.getElementById("form-status");
  function setFormStatus(text, isError) {
    if (!formStatus) return;
    formStatus.textContent = text;
    formStatus.classList.toggle("is-error", Boolean(isError));
  }

  if (form && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!formStatus) return;

      const endpoint = form.getAttribute("data-formspree-url") || "";
      if (!endpoint) {
        setFormStatus(
          "Add PUBLIC_FORMSPREE_FORM_ID to your .env file, then restart the dev server.",
          true,
        );
        formStatus.focus();
        return;
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      setFormStatus("", false);
      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      submitBtn.textContent = "Sending…";

      const honeypot = form.querySelector('input[name="_gotcha"]');
      const emailEl = form.querySelector('input[name="email"]');
      const nameEl = form.querySelector('input[name="name"]');
      if (honeypot) {
        const h = honeypot.value.trim();
        if (h) {
          const emailVal = (emailEl && emailEl.value ? emailEl.value : "").trim();
          const nameVal = (nameEl && nameEl.value ? nameEl.value : "").trim();
          const hl = h.toLowerCase();
          if (hl === emailVal.toLowerCase() || hl === nameVal.toLowerCase()) {
            honeypot.value = "";
          }
        }
      }

      const fd = new FormData(form);

      try {
        const res = await fetch(endpoint, {
          method: "POST",
          body: fd,
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          form.reset();
          setFormStatus(
            "You're on the list! We'll email you when the first cohort opens: dates, details, and how to apply.",
            false,
          );
          formStatus.focus();
        } else if (res.status === 403) {
          setFormStatus(
            "That submission could not go through. Try again in a moment or use a different network.",
            true,
          );
          formStatus.focus();
        } else if (data && data.errors) {
          const first = Object.keys(data.errors)[0];
          const msg =
            first && data.errors[first] && data.errors[first][0]
              ? data.errors[first][0]
              : "Something went wrong. Try again in a moment.";
          setFormStatus(msg, true);
          formStatus.focus();
        } else {
          setFormStatus("We could not send that. Check your connection and try again.", true);
          formStatus.focus();
        }
      } catch {
        setFormStatus("We could not send that. Check your connection and try again.", true);
        formStatus.focus();
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });
  }
  </script>
</Layout>
