---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import whyBuild from "../assets/why/build.png";
import whySisterhood from "../assets/why/sisterhood.png";
import whySkills from "../assets/why/skills.png";

const title = "Why We Built This — Her AI Studio";
const description = "Where girls and women become confident AI creators, builders, and engineers. Discover why Her AI Studio exists.";
---

<Layout {title} {description}>

  <Nav currentPath="/why" />

  <main id="main-content">
  <section id="why" class="studio-room room-floor" aria-labelledby="why-heading">
    <div class="room-inner">
      <p class="room-label" data-reveal>Why we built this</p>
      <h2 id="why-heading" style="font-size:clamp(2.5rem,5.5vw,4rem);margin-bottom:2.5rem;max-width:100%;" data-reveal data-delay="1">
        Where girls and women become<br>confident AI creators, builders, and engineers.
      </h2>

      <div class="why-zigzag">
        <article class="why-row why-row--media-end" data-reveal data-delay="2">
          <div class="why-row__text">
            <h3 class="why-row__title">
              <span class="why-row__glyph" aria-hidden="true">✦</span>
              Build real things
            </h3>
            <p class="why-row__body">
              Work with real hardware to build your own cyberdeck: a pocket-sized AI device you design and program yourself.
            </p>
          </div>
          <figure class="why-row__figure">
            <img
              src={whyBuild.src}
              width={whyBuild.width}
              height={whyBuild.height}
              alt="Three students collaborating at a table with laptops, a tablet, and floating previews of apps and creative tools."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>

        <article class="why-row why-row--media-start" data-reveal data-delay="3">
          <figure class="why-row__figure">
            <img
              src={whySisterhood.src}
              width={whySisterhood.width}
              height={whySisterhood.height}
              alt="Five students gathered around a laptop, learning together in a warm, welcoming space."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="why-row__text">
            <h3 class="why-row__title">
              <span class="why-row__glyph why-row__glyph--heart" aria-hidden="true">♡</span>
              A sisterhood
            </h3>
            <p class="why-row__body">
              Learn alongside the people who get it. Mentors, peers, and role models who look like you.
            </p>
          </div>
        </article>

        <article class="why-row why-row--media-end" data-reveal data-delay="4">
          <div class="why-row__text">
            <h3 class="why-row__title">
              <span class="why-row__glyph why-row__glyph--future" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M3 18c4.5-1 8-4 11.5-8.5S19.5 5.5 21 4"
                    stroke="currentColor"
                    stroke-width="1.85"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path d="M3 20.5h18" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" />
                  <circle cx="21" cy="4" r="2.35" fill="currentColor" />
                  <path
                    d="M17.5 3.5 21 4l-1.2 3.2"
                    stroke="currentColor"
                    stroke-width="1.35"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              Future-ready skills
            </h3>
            <p class="why-row__body">
              Local AI, prompt engineering, machine learning intuition, and ethical AI thinking that schools don't teach yet.
            </p>
          </div>
          <figure class="why-row__figure">
            <img
              src={whySkills.src}
              width={whySkills.width}
              height={whySkills.height}
              alt="A student at her desk at night with floating panels about prompts, machine learning, and ethical AI."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </article>
      </div>
    </div>
  </section>

  <Footer currentPath="/why" />
  </main>

</Layout>
