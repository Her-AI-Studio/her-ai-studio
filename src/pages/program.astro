---
import "../styles/workshop.css";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import studentsPhoto from "../assets/paris-skulk.png";

const title = "Program — Her AI Studio";
const description = "Three weeks. Learn it, build it, show it. Her AI Studio's cadence takes you from AI fundamentals to a capstone showcase.";

const studentsImageWidths = [320, 480, 640, 800, 1000];
const studentsImageSizes = "(max-width: 860px) min(520px, 90vw), 42vw";

const weeks = [
  {
    title: "Learn",
    body: "AI engineering fundamentals, delivered through our web-based curriculum. No hardware yet: understand how models actually work, and meet the women who've shaped this field before you.",
  },
  {
    title: "Build",
    body: "Wire up your AI kit and put what you learned into practice. This is the hands-on week: real hardware, real code, mentored by college engineers.",
  },
  {
    title: "Showcase",
    body: "Finish your capstone project and present it at a studio showcase to friends, family, and industry guests.",
  },
];
---

<Layout {title} {description}>

  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&display=swap"
  />

  <Nav currentPath="/program" />

  <main id="main-content" class="ws">

    <section class="ws-section program-hero-section" aria-labelledby="program-heading">
      <div class="ws-shell program-grid">
        <div class="program-copy">
          <p class="ws-eyebrow ws-eyebrow--blue">// What we're shaping</p>
          <h1 id="program-heading" class="ws-h2">Learn it. Build it. Show it.</h1>
          <p class="ws-body ws-body--wide">
            We're designing the studio around this cadence: one week of learning, one week of building, one week to showcase what you made. Details may evolve as we build the cohort, and we'll share milestones when you join the list.
          </p>

          <ol class="ws-principles ws-principles--light">
            {weeks.map((week, i) => (
              <li>
                <span class="ws-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h2 class="ws-principle-title">Week {i + 1}: {week.title}</h2>
                  <p class="ws-body">{week.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <figure class="program-figure">
          <div class="ws-photo ws-photo--tilt-right">
            <div class="ws-photo-frame">
              <Image
                src={studentsPhoto}
                alt="Four women sit side by side at a long table, laptops open, wiring up hardware kits together during a workshop session."
                widths={studentsImageWidths}
                sizes={studentsImageSizes}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <p class="ws-photo-note pt-10">a group of hardware hackers learning together at a Vue Vixens workshop, the nonprofit that came before this one ↑</p>
        </figure>
      </div>
    </section>

    <Footer currentPath="/program" />
  </main>

</Layout>

<style>
  .program-hero-section {
    padding-top: 4rem;
    border-bottom: none;
  }

  .program-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .program-copy,
  .program-figure {
    min-width: 0;
  }

  .program-copy .ws-principles {
    max-width: 62ch;
  }

  .program-figure {
    margin: 0.5rem 0 0 auto;
    max-width: 420px;
  }

  @media (max-width: 860px) {
    .program-grid {
      grid-template-columns: 1fr;
    }
    .program-figure {
      margin: 0 auto;
    }
  }
</style>
